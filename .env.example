# ── LLM (default provider: DeepSeek) ─────────────────────────────────────
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com
BEAR_MODEL=deepseek-v4-flash
BULL_MODEL=deepseek-v4-flash
JUDGE_MODEL=deepseek-v4-pro
SUMMARY_MODEL=deepseek-v4-flash

# ── Alternative: OpenAI (override the block above) ───────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# BEAR_MODEL=gpt-4o-mini
# BULL_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o
# SUMMARY_MODEL=gpt-4o-mini

# ── Alternative: Qwen (DashScope, OpenAI-compatible) ─────────────────────
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BEAR_MODEL=qwen-plus
# BULL_MODEL=qwen-plus
# JUDGE_MODEL=qwen-plus
# SUMMARY_MODEL=qwen-plus

# LangSmith (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=bear-bull-debate

# Debate controls
MAX_ROUNDS=2
HISTORY_WINDOW=4
MESSAGE_THRESHOLD=12
MAX_TOOL_ROUNDS=5

# Checkpointer (leave empty for in-memory)
DATABASE_URL=
