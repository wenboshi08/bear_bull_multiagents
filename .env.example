# LLM
OPENAI_API_KEY=sk-...
# Optional: OpenAI-compatible endpoint (DeepSeek/Qwen-DashScope). Leave empty for OpenAI.
OPENAI_BASE_URL=
# LangSmith (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=bear-bull-debate
# Model routing
BEAR_MODEL=gpt-4o-mini
BULL_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o
SUMMARY_MODEL=gpt-4o-mini
# Debate controls
MAX_ROUNDS=2
HISTORY_WINDOW=4
MESSAGE_THRESHOLD=12
MAX_TOOL_ROUNDS=5
# Checkpointer (leave empty for in-memory)
DATABASE_URL=
